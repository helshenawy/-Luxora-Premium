{
  "name": "luxora-zid-theme",
  "version": "1.0.72",
  "description": "LUXORA — Premium Luxury Fashion Theme for Zid",
  "type": "module",
  "scripts": {
    "dev": "npm-run-all --parallel dev:*",
    "dev:css": "tailwindcss -i assets/tailwindcss.css -o assets/styles.css --watch",
    "dev:js": "cross-env ENTRY=main vite build --watch",
    "build": "npm-run-all build:*",
    "build:css": "tailwindcss -i assets/tailwindcss.css -o assets/styles.css --minify",
    "build:js": "cross-env NODE_ENV=production ENTRY=main vite build && cross-env NODE_ENV=production ENTRY=cart vite build",
    "build:dev": "cross-env ENTRY=main vite build && cross-env ENTRY=cart vite build",
    "format": "prettier --write \"**/*.{css,js,json,jinja,html}\""
  },
  "keywords": [
    "zid",
    "vitrin",
    "theme",
    "luxury",
    "fashion",
    "ecommerce"
  ],
  "author": "LUXORA Themes",
  "license": "UNLICENSED",
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.13",
    "@tailwindcss/typography": "^0.5.19",
    "cross-env": "^7.0.3",
    "npm-run-all2": "^8.0.4",
    "prettier": "^3.6.2",
    "prettier-plugin-jinja-template": "^2.1.0",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "tailwindcss": "^4.1.13",
    "vite": "^7.3.0"
  },
  "dependencies": {
    "embla-carousel": "^8.6.0",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-fade": "^8.6.0",
    "nouislider": "^15.8.1",
    "photoswipe": "^5.4.4"
  }
}
