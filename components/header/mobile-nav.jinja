<div class="mobile-nav-overlay" id="mobile-nav-overlay" aria-hidden="true"></div>
<nav
  class="mobile-nav"
  id="mobile-nav"
  role="dialog"
  aria-modal="true"
  aria-label="{% if session.lang == 'ar' %}القائمة الرئيسية{% else %}Main Navigation{% endif %}"
  hidden
>
  <div class="mobile-nav__header">
    <a href="/" class="mobile-nav__logo" aria-label="{{ store.name }}">
      {% if settings.logo_mobile %}
        <img src="{{ settings.logo_mobile }}" alt="{{ store.name }}" width="100" />
      {% else %}
        {{ store.name }}
      {% endif %}
    </a>
    <button class="mobile-nav__close" id="mobile-nav-close" aria-label="{% if session.lang == 'ar' %}إغلاق{% else %}Close{% endif %}">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
  </div>

  <ul class="mobile-nav__links">
    {% for category in categories %}
      <li class="mobile-nav__item">
        <a href="{{ category.url }}" class="mobile-nav__link">{{ category.name }}</a>
      </li>
    {% endfor %}
  </ul>

  <div class="mobile-nav__footer">
    {% if not settings.hide_language | default(false) %}
      <div class="mobile-nav__lang">
        {% if session.lang == 'ar' %}
          <a href="?lang=en" class="mobile-nav__lang-btn">English</a>
        {% else %}
          <a href="?lang=ar" class="mobile-nav__lang-btn">العربية</a>
        {% endif %}
      </div>
    {% endif %}
    <div class="mobile-nav__social">
      {% if settings.social_instagram | default('') %}
        <a href="{{ settings.social_instagram }}" target="_blank" rel="noopener" aria-label="Instagram" class="mobile-nav__social-link">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4"/></svg>
        </a>
      {% endif %}
      {% if settings.social_tiktok | default('') %}
        <a href="{{ settings.social_tiktok }}" target="_blank" rel="noopener" aria-label="TikTok" class="mobile-nav__social-link">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-2.88 2.5 2.89 2.89 0 0 1-2.89-2.89 2.89 2.89 0 0 1 2.89-2.89c.28 0 .54.04.79.1V9.01a6.33 6.33 0 0 0-.79-.05 6.34 6.34 0 0 0-6.34 6.34 6.34 6.34 0 0 0 6.34 6.34 6.34 6.34 0 0 0 6.33-6.34V9a8.17 8.17 0 0 0 4.78 1.53V7.08a4.85 4.85 0 0 1-1.01-.39z"/></svg>
        </a>
      {% endif %}
    </div>
  </div>
</nav>
