{% set product_url = url_for('product_details', slug=product.slug) %}
{% set selected_product = product.selected_product | default(none) %}
{% set cart_product_id = selected_product.id if selected_product else product.id %}
{% set needs_selection = product.has_options | default(false) or product.has_fields | default(false) or product.product_class | default('') == 'dynamic_bundle' %}
{% set product_img = '' %}
{% if product.main_image and product.main_image.image %}
  {% set product_img = image_url(product.main_image.image.large, w=600, q=80, f='auto') %}
{% elif product.images and product.images | length > 0 %}
  {% set product_img = image_url(product.images[0].image.full_size, w=400, q=85, f='auto') %}
{% endif %}

<article class="product-card" data-product-id="{{ product.id }}" data-needs-selection="{{ 'true' if needs_selection else 'false' }}" data-reveal>
  <a href="{{ product_url }}" class="product-card__media-link" tabindex="-1" aria-hidden="true">
    <div class="product-card__media" style="aspect-ratio: {{ settings.product_card_image_aspect_ratio | default('3/4') }}">
      {% if product_img %}
        <img
          src="{{ product_img }}"
          alt="{{ product.name }}"
          loading="lazy"
          class="product-card__img"
          width="400"
          height="533"
        />
      {% else %}
        <div class="product-card__img-placeholder"></div>
      {% endif %}

      {% if product.badge | default('') %}
        <span class="product-card__badge">{{ product.badge }}</span>
      {% elif product.label | default('') %}
        <span class="product-card__badge">{{ product.label }}</span>
      {% endif %}

      <button
        class="product-card__wishlist"
        data-product-id="{{ product.id }}"
        aria-label="{% if session.lang == 'ar' %}أضيفي للمفضلة{% else %}Add to wishlist{% endif %}"
      >
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
      </button>

      <div class="product-card__overlay" aria-hidden="true">
        <button
          class="product-card__quick-view"
          data-product-id="{{ product.id }}"
          data-product-url="{{ product_url }}"
          aria-label="{% if session.lang == 'ar' %}نظرة سريعة{% else %}Quick View{% endif %}"
        >
          {% if session.lang == 'ar' %}نظرة سريعة{% else %}Quick View{% endif %}
        </button>
      </div>
    </div>
  </a>

  <div class="product-card__info">
    {% if product.category and product.category.name %}
      <a href="{{ product.category.url | default('/categories') }}" class="product-card__cat">{{ product.category.name }}</a>
    {% endif %}
    <a href="{{ product_url }}" class="product-card__name">{{ product.name }}</a>
    <div class="product-card__price-row">
      {% if product.formatted_sale_price | default('') and product.formatted_sale_price != product.formatted_price %}
        <span class="product-card__price product-card__price--sale">{{ product.formatted_sale_price }}</span>
        <span class="product-card__price product-card__price--original">{{ product.formatted_price }}</span>
      {% else %}
        <span class="product-card__price">{{ product.formatted_price | default(product.price) }}</span>
      {% endif %}
    </div>
  </div>

  {% if needs_selection %}
  <a class="product-card__add-btn" href="{{ product_url }}" aria-label="{% if session.lang == 'ar' %}اختاري الخيارات{% else %}Choose options{% endif %}">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
  </a>
  {% else %}
  <button
    class="product-card__add-btn"
    data-product-id="{{ cart_product_id }}"
    data-product-url="{{ product_url }}"
    aria-label="{% if session.lang == 'ar' %}أضيفي للسلة{% else %}Add to Cart{% endif %}"
    {% if product.quantity is defined and product.quantity <= 0 and not product.is_infinite %}disabled{% endif %}
  >
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
  </button>
  {% endif %}
</article>
