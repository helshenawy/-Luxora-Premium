{% set s = section.settings if section is defined else {} %}
{% set product_limit = s.limit | default(8) | int %}
{% set _products = products if products is defined and products | length > 0 else (store.products if store.products is defined else []) %}
{% set _mode = s.display_mode | default('grid') %}
{% set _dp_imgs = [
  'https://images.unsplash.com/photo-1583391733956-3750e0ff4e8b?w=600&h=800&q=90&fit=crop&auto=format',
  'https://images.unsplash.com/photo-1469334031218-e382a71b716b?w=600&h=800&q=90&fit=crop&auto=format',
  'https://images.unsplash.com/photo-1529139574466-a303027f1573?w=600&h=800&q=90&fit=crop&auto=format',
  'https://images.unsplash.com/photo-1485968579580-fc6f6e4a90f8?w=600&h=800&q=90&fit=crop&auto=format',
  'https://images.unsplash.com/photo-1496747611176-843222e1e57c?w=600&h=800&q=90&fit=crop&auto=format',
  'https://images.unsplash.com/photo-1558618666-fcd25c85cd64?w=600&h=800&q=90&fit=crop&auto=format',
  'https://images.unsplash.com/photo-1551803091-e20673f15770?w=600&h=800&q=90&fit=crop&auto=format',
  'https://images.unsplash.com/photo-1617137968427-85924c800a22?w=600&h=800&q=90&fit=crop&auto=format'
] %}
{% set _dp_ar   = ['فستان سهرة راقي','عباءة كلاسيكية','بلوزة أنيقة','تنورة ميدي','طقم فاخر','قميص حرير','فستان محتشم','عباءة مطرزة'] %}
{% set _dp_en   = ['Evening Gown','Classic Abaya','Elegant Blouse','Midi Skirt','Luxury Set','Silk Shirt','Modest Dress','Embroidered Abaya'] %}
{% set _dp_p_ar = ['٨٩٩ ر.س','٦٤٩ ر.س','٣٤٩ ر.س','٤٤٩ ر.س','١٢٩٩ ر.س','٥٤٩ ر.س','٧٤٩ ر.س','٨٤٩ ر.س'] %}
{% set _dp_p_en = ['SAR 899','SAR 649','SAR 349','SAR 449','SAR 1,299','SAR 549','SAR 749','SAR 849'] %}
{% set _dp_s_ar = ['','٥٤٩ ر.س','','','','٤٤٩ ر.س','',''] %}
{% set _dp_s_en = ['','SAR 549','','','','SAR 449','',''] %}
{% set _dp_cat_ar = ['فساتين','عباءات','بلوزات','تنانير','أطقم','قمصان','فساتين','عباءات'] %}
{% set _dp_cat_en = ['Dresses','Abayas','Blouses','Skirts','Sets','Shirts','Dresses','Abayas'] %}
<style>.section-products .product-card{opacity:1!important;animation:none!important;transform:none!important}</style>
<section class="section section-products section-y">
  <div class="container">
    {% set title = (s.title_ar | default('وصول جديد')) if session.lang == 'ar' else (s.title_en | default('New Arrivals')) %}
    {% set subtitle = (s.subtitle_ar | default('اكتشفي أحدث التشكيلات')) if session.lang == 'ar' else (s.subtitle_en | default('Discover our latest collections')) %}
    {% include "components/shared/section-header.jinja" %}

    {% if s.show_category_tabs | default(true) %}
    <div class="products-tabs" data-products-tabs aria-label="{% if session.lang == 'ar' %}تصفية حسب التصنيف{% else %}Filter by category{% endif %}">
      <button class="products-tab is-active" data-cat="">{% if session.lang == 'ar' %}الكل{% else %}All{% endif %}</button>
    </div>
    {% endif %}

    {% if _mode == 'carousel' %}
    <div class="products-carousel" data-products-carousel>
      <button class="products-carousel__btn products-carousel__btn--prev" aria-label="{% if session.lang == 'ar' %}السابق{% else %}Previous{% endif %}">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="{% if session.lang == 'ar' %}9 18 15 12 9 6{% else %}15 18 9 12 15 6{% endif %}"/></svg>
      </button>
      <div
        class="products-carousel__track"
        data-products-section
        data-mode="carousel"
        data-columns="{{ s.columns_desktop | default('4') }}"
        data-limit="{{ product_limit }}"
        data-category="{{ s.category_id | default('') }}"
        data-lang="{{ session.lang | default('ar') }}"
      >
        {% if _products | length > 0 %}
          {% for product in _products[:product_limit] %}
            {% include "components/products/card.jinja" %}
          {% endfor %}
        {% else %}
          {% for i in range(product_limit) %}
            {% set _di = i % 8 %}
            {% set _sale = _dp_s_ar[_di] if session.lang == 'ar' else _dp_s_en[_di] %}
            {% set _orig = _dp_p_ar[_di] if session.lang == 'ar' else _dp_p_en[_di] %}
            <article class="product-card">
              <a href="/products" class="product-card__media-link" tabindex="-1" aria-hidden="true">
                <div class="product-card__media" style="aspect-ratio:{{ settings.product_card_image_aspect_ratio | default('3/4') }}">
                  <img src="{{ _dp_imgs[_di] }}" alt="{{ _dp_ar[_di] if session.lang == 'ar' else _dp_en[_di] }}" loading="lazy" class="product-card__img" width="400" height="533" />
                </div>
              </a>
              <div class="product-card__info">
                <a href="/categories" class="product-card__cat">{{ _dp_cat_ar[_di] if session.lang == 'ar' else _dp_cat_en[_di] }}</a>
                <a href="/products" class="product-card__name">{{ _dp_ar[_di] if session.lang == 'ar' else _dp_en[_di] }}</a>
                <div class="product-card__price-row">
                  {% if _sale %}<span class="product-card__price product-card__price--sale">{{ _sale }}</span><span class="product-card__price product-card__price--original">{{ _orig }}</span>
                  {% else %}<span class="product-card__price">{{ _orig }}</span>{% endif %}
                </div>
              </div>
            </article>
          {% endfor %}
        {% endif %}
      </div>
      <button class="products-carousel__btn products-carousel__btn--next" aria-label="{% if session.lang == 'ar' %}التالي{% else %}Next{% endif %}">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="{% if session.lang == 'ar' %}15 18 9 12 15 6{% else %}9 18 15 12 9 6{% endif %}"/></svg>
      </button>
    </div>
    {% else %}
    <div
      class="products-grid products-grid--{{ s.columns_desktop | default('4') }}"
      data-columns="{{ s.columns_desktop | default('4') }}"
      data-products-section
      data-mode="grid"
      data-limit="{{ product_limit }}"
      data-category="{{ s.category_id | default('') }}"
      data-lang="{{ session.lang | default('ar') }}"
    >
      {% if _products | length > 0 %}
        {% for product in _products[:product_limit] %}
          {% include "components/products/card.jinja" %}
        {% endfor %}
      {% else %}
        {% for i in range(product_limit) %}
          {% set _di = i % 8 %}
          {% set _sale = _dp_s_ar[_di] if session.lang == 'ar' else _dp_s_en[_di] %}
          {% set _orig = _dp_p_ar[_di] if session.lang == 'ar' else _dp_p_en[_di] %}
          <article class="product-card">
            <a href="/products" class="product-card__media-link" tabindex="-1" aria-hidden="true">
              <div class="product-card__media" style="aspect-ratio:{{ settings.product_card_image_aspect_ratio | default('3/4') }}">
                <img src="{{ _dp_imgs[_di] }}" alt="{{ _dp_ar[_di] if session.lang == 'ar' else _dp_en[_di] }}" loading="lazy" class="product-card__img" width="400" height="533" />
              </div>
            </a>
            <div class="product-card__info">
              <a href="/categories" class="product-card__cat">{{ _dp_cat_ar[_di] if session.lang == 'ar' else _dp_cat_en[_di] }}</a>
              <a href="/products" class="product-card__name">{{ _dp_ar[_di] if session.lang == 'ar' else _dp_en[_di] }}</a>
              <div class="product-card__price-row">
                {% if _sale %}<span class="product-card__price product-card__price--sale">{{ _sale }}</span><span class="product-card__price product-card__price--original">{{ _orig }}</span>
                {% else %}<span class="product-card__price">{{ _orig }}</span>{% endif %}
              </div>
            </div>
          </article>
        {% endfor %}
      {% endif %}
    </div>
    {% endif %}

    {% if s.show_view_all | default(true) %}
      <div class="section-products__footer">
        <a href="{{ s.view_all_url | default('/products') }}" class="btn btn--outline">
          {% if session.lang == 'ar' %}عرض جميع المنتجات{% else %}View All Products{% endif %}
        </a>
      </div>
    {% endif %}
  </div>
</section>

{% if _products | length == 0 %}
<script>
(function () {
  var grid = document.querySelector('[data-products-section]');
  if (!grid) return;
  var limit = grid.dataset.limit || 8;
  var category = grid.dataset.category || '';
  var lang = grid.dataset.lang || 'ar';
  var isAr = lang === 'ar';
  var mode = grid.dataset.mode || 'grid';
  var url = '/api/v1/products?limit=' + limit + (category ? '&category_id=' + category : '');

  var cartSvg = '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>';

  fetch(url, { headers: { 'Accept': 'application/json' } })
    .then(function (r) { return r.json(); })
    .then(function (data) {
      var items = data.results || [];
      if (!items.length) return;
      grid.innerHTML = items.map(function (p) {
        var img = (p.images && p.images[0] && p.images[0].image) ? p.images[0].image.large : '';
        var name = p.name || '';
        var price = p.formatted_price || '';
        var salePrice = p.formatted_sale_price || '';
        var productUrl = p.html_url || ('/products/' + p.slug);
        var selectedProduct = p.selected_product || (p.variants && p.variants[0]) || null;
        var cartProductId = selectedProduct && selectedProduct.id ? selectedProduct.id : p.id;
        var needsSelection = !!(p.has_options || p.has_fields || p.product_class === 'dynamic_bundle' || (p.options && p.options.length));
        var mediaHtml = img
          ? '<img src="' + img + '" alt="' + name.replace(/"/g, '&quot;') + '" loading="lazy" class="product-card__img" width="400" height="533">'
          : '<div class="product-card__img-placeholder"></div>';
        var priceHtml = (salePrice && salePrice !== price)
          ? '<span class="product-card__price product-card__price--sale">' + salePrice + '</span><span class="product-card__price product-card__price--original">' + price + '</span>'
          : '<span class="product-card__price">' + price + '</span>';
        var disabledAttr = (!p.is_infinite && p.quantity !== undefined && p.quantity <= 0) ? ' disabled' : '';
        return '<article class="product-card" data-product-id="' + p.id + '">'
          + '<a href="' + productUrl + '" class="product-card__media-link" tabindex="-1" aria-hidden="true">'
          + '<div class="product-card__media" style="aspect-ratio:3/4">'
          + mediaHtml
          + '<div class="product-card__overlay" aria-hidden="true">'
          + '<button class="product-card__quick-view" data-product-id="' + p.id + '" data-product-url="' + productUrl + '" aria-label="' + (isAr ? 'نظرة سريعة' : 'Quick View') + '">'
          + (isAr ? 'نظرة سريعة' : 'Quick View')
          + '</button></div></div></a>'
          + '<div class="product-card__info">'
          + '<a href="' + productUrl + '" class="product-card__name">' + name + '</a>'
          + '<div class="product-card__price-row">' + priceHtml + '</div>'
          + '</div>'
          + (needsSelection
            ? '<a class="product-card__add-btn" href="' + productUrl + '" aria-label="' + (isAr ? 'اختاري الخيارات' : 'Choose options') + '">' + cartSvg + '</a>'
            : '<button class="product-card__add-btn" data-product-id="' + cartProductId + '" data-product-url="' + productUrl + '" aria-label="' + (isAr ? 'أضيفي للسلة' : 'Add to Cart') + '"' + disabledAttr + '>' + cartSvg + '</button>')
          + '</article>';
      }).join('');
    })
    .catch(function () { grid.innerHTML = ''; });
})();
</script>
{% endif %}

<script>
(function () {
  var carousel = document.querySelector('[data-products-carousel]');
  if (!carousel) return;
  var track = carousel.querySelector('.products-carousel__track');
  var btnPrev = carousel.querySelector('.products-carousel__btn--prev');
  var btnNext = carousel.querySelector('.products-carousel__btn--next');
  if (!track || !btnPrev || !btnNext) return;
  function getScrollAmount() {
    var card = track.querySelector('.product-card');
    return card ? card.offsetWidth + 24 : 280;
  }
  btnPrev.addEventListener('click', function () {
    track.scrollBy({ left: -getScrollAmount() * 2, behavior: 'smooth' });
  });
  btnNext.addEventListener('click', function () {
    track.scrollBy({ left: getScrollAmount() * 2, behavior: 'smooth' });
  });
  function updateBtns() {
    var atStart = track.scrollLeft <= 4;
    var atEnd = track.scrollLeft + track.clientWidth >= track.scrollWidth - 4;
    var isRtl = document.documentElement.dir === 'rtl';
    btnPrev.style.opacity = (isRtl ? atEnd : atStart) ? '0.3' : '1';
    btnNext.style.opacity = (isRtl ? atStart : atEnd) ? '0.3' : '1';
  }
  track.addEventListener('scroll', updateBtns, { passive: true });
  updateBtns();
})();
</script>

<script>
(function () {
  var tabsEl = document.querySelector('[data-products-tabs]');
  if (!tabsEl) return;
  var grid = document.querySelector('[data-products-section]');
  if (!grid) return;
  var limit = parseInt(grid.dataset.limit) || 8;
  var lang = grid.dataset.lang || 'ar';
  var isAr = lang === 'ar';
  var cartSvg = '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>';

  function buildCard(p) {
    var img = (p.images && p.images[0] && p.images[0].image) ? p.images[0].image.large : '';
    var name = p.name || '';
    var price = p.formatted_price || '';
    var salePrice = p.formatted_sale_price || '';
    var productUrl = p.html_url || ('/products/' + p.slug);
    var selectedProduct = p.selected_product || (p.variants && p.variants[0]) || null;
    var cartProductId = selectedProduct && selectedProduct.id ? selectedProduct.id : p.id;
    var needsSelection = !!(p.has_options || p.has_fields || p.product_class === 'dynamic_bundle' || (p.options && p.options.length));
    var mediaHtml = img
      ? '<img src="' + img + '" alt="' + name.replace(/"/g, '&quot;') + '" loading="lazy" class="product-card__img" width="400" height="533">'
      : '<div class="product-card__img-placeholder"></div>';
    var priceHtml = (salePrice && salePrice !== price)
      ? '<span class="product-card__price product-card__price--sale">' + salePrice + '</span><span class="product-card__price product-card__price--original">' + price + '</span>'
      : '<span class="product-card__price">' + price + '</span>';
    var disabledAttr = (!p.is_infinite && p.quantity !== undefined && p.quantity <= 0) ? ' disabled' : '';
    var catName = (p.category && p.category.name) ? p.category.name : '';
    var catUrl = (p.category && p.category.url) ? p.category.url : '/categories';
    var catHtml = catName ? '<a class="product-card__cat" href="' + catUrl + '">' + catName + '</a>' : '';
    return '<article class="product-card" data-product-id="' + p.id + '">'
      + '<a href="' + productUrl + '" class="product-card__media-link" tabindex="-1" aria-hidden="true">'
      + '<div class="product-card__media" style="aspect-ratio:3/4">'
      + mediaHtml
      + '<div class="product-card__overlay" aria-hidden="true">'
      + '<button class="product-card__quick-view" data-product-id="' + p.id + '" data-product-url="' + productUrl + '" aria-label="' + (isAr ? 'نظرة سريعة' : 'Quick View') + '">'
      + (isAr ? 'نظرة سريعة' : 'Quick View')
      + '</button></div></div></a>'
      + '<div class="product-card__info">'
      + catHtml
      + '<a href="' + productUrl + '" class="product-card__name">' + name + '</a>'
      + '<div class="product-card__price-row">' + priceHtml + '</div>'
      + '</div>'
      + (needsSelection
        ? '<a class="product-card__add-btn" href="' + productUrl + '" aria-label="' + (isAr ? 'اختاري الخيارات' : 'Choose options') + '">' + cartSvg + '</a>'
        : '<button class="product-card__add-btn" data-product-id="' + cartProductId + '" data-product-url="' + productUrl + '" aria-label="' + (isAr ? 'أضيفي للسلة' : 'Add to Cart') + '"' + disabledAttr + '>' + cartSvg + '</button>')
      + '</article>';
  }

  function setActive(tab) {
    tabsEl.querySelectorAll('.products-tab').forEach(function (t) { t.classList.remove('is-active'); });
    tab.classList.add('is-active');
  }

  function loadCategory(catId) {
    grid.style.opacity = '0.55';
    grid.style.pointerEvents = 'none';
    var url = '/api/v1/products?limit=' + limit + (catId ? '&category_id=' + catId : '');
    fetch(url, { headers: { 'Accept': 'application/json' } })
      .then(function (r) { return r.json(); })
      .then(function (data) {
        grid.style.opacity = '';
        grid.style.pointerEvents = '';
        var items = data.results || [];
        if (!items.length) return;
        grid.innerHTML = items.map(buildCard).join('');
      })
      .catch(function () { grid.style.opacity = ''; grid.style.pointerEvents = ''; });
  }

  var allTab = tabsEl.querySelector('[data-cat=""]');
  if (allTab) {
    allTab.addEventListener('click', function () { setActive(this); loadCategory(''); });
  }

  fetch('/api/v1/categories', { headers: { 'Accept': 'application/json' } })
    .then(function (r) { return r.json(); })
    .then(function (data) {
      var cats = Array.isArray(data) ? data : Object.values(data);
      cats.slice(0, 7).forEach(function (c) {
        var btn = document.createElement('button');
        btn.className = 'products-tab';
        btn.dataset.cat = c.id || '';
        btn.textContent = c.name || '';
        btn.addEventListener('click', function () { setActive(btn); loadCategory(c.id); });
        tabsEl.appendChild(btn);
      });
    })
    .catch(function () {});
})();
</script>
