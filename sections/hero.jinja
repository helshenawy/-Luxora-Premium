{% set s = section.settings if section is defined else {} %}
<section
  class="section-hero"
  style="min-height: {{ s.min_height | default(65) }}vh;"
  aria-label="{% if session.lang == 'ar' %}البانر الرئيسي{% else %}Hero Banner{% endif %}"
>
  {% set _hero_img = s.image | default('https://images.unsplash.com/photo-1515886657613-9f3515b0c78f?w=1920&q=85&fit=crop') %}
  <picture class="section-hero__bg">
    {% if s.image_mobile | default('') %}
      <source media="(max-width: 767px)" srcset="{{ s.image_mobile }}" />
    {% endif %}
    <img
      src="{{ _hero_img }}"
      alt="{% if session.lang == 'ar' %}{{ s.heading_ar | default('الإطلالة المثالية') }}{% else %}{{ s.heading_en | default('The Perfect Look') }}{% endif %}"
      loading="eager"
      fetchpriority="high"
      class="section-hero__bg-img"
    />
  </picture>

  <div
    class="section-hero__overlay"
    style="opacity: {{ (s.overlay_opacity | default(45)) / 100 }};"
    aria-hidden="true"
  ></div>

  <div class="container section-hero__content section-hero__content--{{ s.layout | default('start') }}" data-reveal>
    {% set subheading = (s.subheading_ar | default('تشكيلة ٢٠٢٥')) if session.lang == 'ar' else (s.subheading_en | default('Collection 2025')) %}
    {% set heading = (s.heading_ar | default('الإطلالة المثالية')) if session.lang == 'ar' else (s.heading_en | default('The Perfect Look')) %}
    {% set cta_text = (s.cta_text_ar | default('اكتشفي التشكيلة')) if session.lang == 'ar' else (s.cta_text_en | default('Explore Collection')) %}

    {% if subheading %}
      <span class="section-hero__eyebrow">{{ subheading }}</span>
    {% endif %}

    {% if heading %}
      <h2 class="section-hero__heading">{{ heading }}</h2>
    {% endif %}

    <a href="{{ s.cta_url | default('/products') }}" class="btn btn--outline-light section-hero__cta">
      {{ cta_text }}
    </a>
  </div>
</section>
