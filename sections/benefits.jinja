{% macro benefit_icon(type) %}
  {% if type == 'shipping' %}
    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M5 17H3a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11a2 2 0 0 1 2 2v3"/><rect x="9" y="11" width="14" height="10" rx="1"/><circle cx="12" cy="21" r="1"/><circle cx="20" cy="21" r="1"/></svg>
  {% elif type == 'return' %}
    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/></svg>
  {% elif type == 'secure' %}
    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
  {% else %}
    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
  {% endif %}
{% endmacro %}

<section class="section-benefits">
  <div class="container">
    <div class="benefits-grid">
      {% for i in [1, 2, 3, 4] %}
        {% set icon = section.settings['benefit_' ~ i ~ '_icon'] | default('shipping') %}
        {% set text = section.settings['benefit_' ~ i ~ '_text_ar'] if session.lang == 'ar' else section.settings['benefit_' ~ i ~ '_text_en'] %}
        {% if text | default('') %}
          <div class="benefit-item">
            <span class="benefit-item__icon">{{ benefit_icon(icon) }}</span>
            <span class="benefit-item__text">{{ text }}</span>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>
