{% set s = section.settings if section is defined else {} %}
{% if s.youtube_id | default('') %}
<section class="section section-video section-y">
  <div class="container">
    {% set heading = s.heading_ar | default('') if session.lang == 'ar' else s.heading_en | default('') %}
    {% set title = heading %}
    {% set subtitle = '' %}
    {% if heading %}
      {% include "components/shared/section-header.jinja" %}
    {% endif %}
    <div class="video-wrapper" data-youtube-id="{{ s.youtube_id }}">
      {% if s.thumbnail | default('') %}
        <img src="{{ s.thumbnail }}" alt="{{ heading }}" class="video-wrapper__thumbnail" loading="lazy" />
      {% endif %}
      <button class="video-wrapper__play" aria-label="{% if session.lang == 'ar' %}تشغيل الفيديو{% else %}Play Video{% endif %}">
        <svg width="56" height="56" viewBox="0 0 24 24" fill="var(--gold)" aria-hidden="true"><circle cx="12" cy="12" r="11" stroke="var(--ivory)" stroke-width="1.5" fill="rgba(28,16,8,.7)"/><polygon points="10,8 18,12 10,16" fill="var(--gold)"/></svg>
      </button>
      <div class="video-wrapper__embed" hidden>
        <iframe
          src="https://www.youtube.com/embed/{{ s.youtube_id }}?autoplay=1"
          frameborder="0"
          allow="autoplay; encrypted-media"
          allowfullscreen
          title="{{ heading | default('Video') }}"
        ></iframe>
      </div>
    </div>
  </div>
</section>
{% endif %}
