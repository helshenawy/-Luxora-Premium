{% set card_columns_desktop = settings.product_card_columns_desktop | default('4') %}
{% set card_columns_mobile = settings.product_card_columns_mobile | default('2') %}
{% set card_image_aspect_ratio = settings.product_card_image_aspect_ratio | default('3/4') %}
{% set font_family = settings.font_family | default('Cairo') %}

<!DOCTYPE html>
<html
  class="no-js"
  lang="{{ session.lang }}"
  dir="{{ session.locale.language.direction }}"
>
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="x-ua-compatible" content="ie=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {% vitrin_head %}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      media="print"
      onload="this.onload=null;this.media='all'"
      href="https://fonts.googleapis.com/css2?family={{ font_family }}:wght@300;400;500;600;700&family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400&family=Cairo:wght@300;400;500;600;700&display=swap"
    />
    <!-- prettier-ignore-start -->
    <style>
      :root {
        --font-family: {{ (font_family | default('Cairo')).replace('+', ' ') }}, 'Noto Naskh Arabic', sans-serif;
        --font-serif: 'Cormorant Garamond', Georgia, serif;

        --espresso:        {{ settings.theme_primary | default('#1C1008') }};
        --ivory:           {{ settings.theme_background | default('#FAF7F2') }};
        --gold:            {{ settings.theme_accent | default('#C9A96E') }};
        --gold-light:      #E8D5A3;
        --cream:           {{ settings.theme_secondary | default('#F2EDE4') }};
        --cream-dark:      #E8DFD0;

        --text-primary:    {{ settings.theme_foreground | default('#1C1008') }};
        --text-secondary:  #5A4A38;
        --text-muted:      {{ settings.theme_muted | default('#8A7868') }};
        --text-inverse:    #FAF7F2;
        --border:          {{ settings.theme_border | default('#E0D8CC') }};
        --surface:         #FFFFFF;

        --shadow-card:     0 4px 24px rgba(28,16,8,.07);
        --shadow-hover:    0 16px 48px rgba(28,16,8,.14);
        --shadow-header:   0 2px 20px rgba(28,16,8,.08);

        --ease-out:        cubic-bezier(0.25, 0.46, 0.45, 0.94);
        --ease-spring:     cubic-bezier(0.34, 1.56, 0.64, 1);
        --t-fast:          0.2s var(--ease-out);
        --t-base:          0.35s var(--ease-out);
        --t-slow:          0.6s var(--ease-out);

        --container-max:   1440px;
        --container-pad:   clamp(1.5rem, 5vw, 5rem);
        --section-y:       clamp(4rem, 8vw, 8rem);

        --espresso-mid:    #2C1A0A;
        --radius-sm:       2px;
        --radius-md:       {{ settings.theme_radius | default(2) }}px;

        --card-columns-desktop: {{ card_columns_desktop }};
        --card-columns-mobile:  {{ card_columns_mobile }};
      }
    </style>
    <!-- prettier-ignore-end -->
    <link rel="stylesheet" href="{{ 'styles.css' | asset_url }}" />
    <link rel="stylesheet" href="{{ 'dist/luxora-zid-theme.css' | asset_url }}" />
  </head>
  <body>
    <a href="#main-content" class="skip-link">{% if session.lang == 'ar' %}انتقل إلى المحتوى{% else %}Skip to content{% endif %}</a>
    {% vitrin_body %}
    {% include "header.jinja" %}
    <main id="main-content" tabindex="-1">
      {% block content %}{% endblock %}
    </main>
    {% include "footer.jinja" %}
    {% include "components/cart/mini-cart.jinja" %}
    {% include "components/products/quick-view.jinja" %}
    {% include "vitrin:shared/region_settings_dialog.jinja" %}
    <script src="{{ 'dist/theme.js' | asset_url }}" defer></script>
    <script src="{{ 'dist/cart-controller.js' | asset_url }}" defer></script>
    {% set _wa_num = settings.social_whatsapp | default('') or store.phone | default('') %}
    {% if _wa_num %}
    <a href="https://wa.me/{{ _wa_num | replace('+', '') | replace(' ', '') | replace('-', '') }}" class="whatsapp-float" target="_blank" rel="noopener" aria-label="{% if session.lang == 'ar' %}تواصل عبر واتساب{% else %}Chat on WhatsApp{% endif %}">
      <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"/></svg>
    </a>
    {% endif %}
  </body>
</html>
