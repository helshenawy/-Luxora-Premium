{% extends "layout.jinja" %}

{% block content %}
  {% for section in home.sections %}
    {% if section.type == 'carousel' %}
      {% include "sections/carousel.jinja" %}
    {% elif section.type == 'hero' %}
      {% include "sections/hero.jinja" %}
    {% elif section.type == 'benefits' %}
      {% include "sections/benefits.jinja" %}
    {% elif section.type == 'categories' %}
      {% include "sections/categories.jinja" %}
    {% elif section.type == 'products' %}
      {% include "sections/products.jinja" %}
    {% elif section.type == 'editorial' %}
      {% include "sections/editorial.jinja" %}
    {% elif section.type == 'call-to-action' %}
      {% include "sections/call-to-action.jinja" %}
    {% elif section.type == 'testimonials' %}
      {% include "sections/testimonials.jinja" %}
    {% elif section.type == 'video' %}
      {% include "sections/video.jinja" %}
    {% elif section.type == 'gallery' %}
      {% include "sections/gallery.jinja" %}
    {% elif section.type == 'countdown' %}
      {% include "sections/countdown.jinja" %}
    {% endif %}
  {% endfor %}
{% endblock %}
