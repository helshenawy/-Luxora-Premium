{% extends "layout.jinja" %}

{% block content %}
<div class="container brands-page section-y">
  <h1 class="page-title">{% if session.lang == 'ar' %}العلامات التجارية{% else %}Brands{% endif %}</h1>
  <div class="brands-grid">
    {% for brand in brands | default([]) %}
      <a href="{{ brand.url }}" class="brand-item">
        {% if brand.image | default('') %}
          <img src="{{ brand.image }}" alt="{{ brand.name }}" loading="lazy" class="brand-item__img" />
        {% else %}
          <span class="brand-item__name">{{ brand.name }}</span>
        {% endif %}
      </a>
    {% else %}
      {% include "components/shared/empty-state.jinja" %}
    {% endfor %}
  </div>
</div>
{% endblock %}
