{% extends "layout.jinja" %}

{% block title %}{% if session.lang == 'ar' %}جميع التصنيفات{% else %}All Categories{% endif %} — {{ store.name }}{% endblock %}

{% block content %}
<div class="categories-page">
  <div class="inner-page-hero">
    <div class="container">
      {% include "components/ui/breadcrumb.jinja" %}
      <h1 class="inner-page-hero__title">
        {% if session.lang == 'ar' %}جميع التصنيفات{% else %}All Categories{% endif %}
      </h1>
    </div>
  </div>

  <div class="container products-page__content">
    <div class="categories-grid categories-grid--4" data-reveal>
      {% for category in categories %}
        <a href="{{ category.url }}" class="category-card">
          <div class="category-card__img-wrap">
            {% if category.image %}
              <img src="{{ category.image }}" alt="{{ category.name }}" loading="lazy" class="category-card__img" />
            {% else %}
              <div class="category-card__img-placeholder"></div>
            {% endif %}
            <div class="category-card__overlay" aria-hidden="true"></div>
          </div>
          <div class="category-card__body">
            <h2 class="category-card__name">{{ category.name }}</h2>
            <span class="category-card__cta">{% if session.lang == 'ar' %}تسوقي{% else %}Shop{% endif %}</span>
          </div>
        </a>
      {% else %}
        {% include "components/shared/empty-state.jinja" %}
      {% endfor %}
    </div>
  </div>
</div>
{% endblock %}
